CONFIG_ENV=config.env

KERNEL_SOURCE=https://github.com/HWYYSWD/Xiaomi_Kernel_OpenSource
KERNEL_SOURCE_BRANCH=cepheus-q-oss
KERNEL_CONFIG=raphael_user_defconfig
ARCH=arm64
KERNEL_FILE=Image.gz-dtb
EXTRA_BUILD_COMMAND:LD=ld.lld LLVM=1 LLVM_IAS=1
DISABLE-LTO=true
ENABLE_KERNELSU=true
APPLY_KSU_PATCH=true
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
DISABLE_CC_WERROR=true
